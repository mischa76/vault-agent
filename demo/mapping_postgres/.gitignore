# dbt build artifacts — regenerated by `dbt deps` / `dbt build`, never committed.
target/
dbt_packages/
logs/
__pycache__/
.user.yml

# The generated raw-vault + staging SQL (models/**/*.sql) and scaffolding (dbt_project.yml,
# packages.yml, models/staging/sources.yml) ARE committed on purpose so reviewers see the
# generator's grounded+ratified output without running the script; package-lock.yml is
# committed to pin AutomateDV / dbt_utils versions for reproducibility.
