# Copy to .env and fill in real values. .env is gitignored.

# LLM route (data residency, manual 5.5): anthropic | bedrock | vertex
LLM_PROVIDER=anthropic
# anthropic: the key. bedrock: AWS_REGION (+ AWS credentials chain, optional AWS_PROFILE).
# vertex: GCP_PROJECT_ID + GCP_REGION (+ Application Default Credentials).
ANTHROPIC_API_KEY=sk-ant-...
AWS_REGION=
AWS_PROFILE=
GCP_PROJECT_ID=
GCP_REGION=
# Models: PRIMARY_MODEL is the Sonnet default; HEAVY_MODEL (Opus) is used by the
# DV2.0 modeler for the hardest reasoning step (ADR-0001). Passed to the provider as
# written: on bedrock/vertex set the IDs that provider lists (prefixes differ).
PRIMARY_MODEL=claude-sonnet-4-6
HEAVY_MODEL=claude-opus-4-8

# Optional: tracing / observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=vault-agent-dev

# Optional: target platforms for demo
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=

# Logging level
LOG_LEVEL=INFO
